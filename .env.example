# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# Postgres connection string. Drizzle Studio and drizzle-kit also read this.
DATABASE_URL="postgresql://verity:verity@localhost:5432/verity"

# Supabase project — Auth (email/password, Google OAuth, email
# verification) is fully owned by Supabase now; this app no longer hashes
# passwords or manages sessions itself. Find these under
# Project Settings > API in your Supabase dashboard. The anon key is safe
# to expose to the browser (NEXT_PUBLIC_*) by design — it's meant to be
# public, access control happens via Supabase's own auth rules.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Used to build the redirect URL Supabase sends people back to after
# email verification and Google OAuth. Must also be added to your
# Supabase project's Auth > URL Configuration > Redirect URLs allow-list.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "false" only for local Docker networking between containers on the
# same compose network. Never set this in a real production deployment —
# production always requires SSL with certificate verification.
DATABASE_SSL=true

# Node environment. Next.js sets this automatically in most cases; only
# override it if you know why.
NODE_ENV=development

# Optional. Only needed if your Postgres provider's certificate chain
# isn't in Node's default trusted-CA bundle (Supabase's pooler is the
# common case — download the .crt from Project Settings > Database >
# SSL Configuration and paste its full contents here, including the
# BEGIN/END CERTIFICATE lines). Leave unset for providers like Neon
# whose certificates already chain to a public CA.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
