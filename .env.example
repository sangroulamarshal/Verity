# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# Postgres connection string. Drizzle Studio and drizzle-kit also read this.
DATABASE_URL="postgresql://verity:verity@localhost:5432/verity"

# Set to "false" only for local Docker networking between containers on the
# same compose network. Never set this in a real production deployment —
# production always requires SSL with certificate verification.
DATABASE_SSL=true

# Node environment. Next.js sets this automatically in most cases; only
# override it if you know why.
NODE_ENV=development
